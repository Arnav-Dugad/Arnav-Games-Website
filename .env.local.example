# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. For Cloudflare, NEXT_PUBLIC_*
# values are read from here at build time; IGDB_* are set with
# `npx wrangler secret put <NAME>`.
#
# NOTHING HERE IS REQUIRED. With no variables set at all, the app falls back to
# the Steam storefront, which needs no credentials. There is no placeholder
# catalogue behind either — if both IGDB and Steam are unreachable, pages show
# an honest "live data unavailable" notice instead of fabricated games.
# ---------------------------------------------------------------------------


# --- Game data: IGDB (recommended, free) -----------------------------------
# IGDB is run by Twitch/Amazon and is the most complete free game database
# available — every platform, covers, screenshots, trailers, critic scores and
# release windows. Without it the site works, but only shows PC titles from
# Steam.
#
# To get credentials (free, ~2 minutes):
#   1. Sign in at https://dev.twitch.tv/console/apps and click "Register Your
#      Application"
#   2. Name: anything. OAuth Redirect URL: http://localhost  Category: Website
#   3. Copy the Client ID, then click "New Secret" and copy that too
#   4. Paste both below
#
# Docs: https://api-docs.igdb.com/#getting-started
# Server-side only — never exposed to the browser.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=


# --- Game data: Steam (no configuration needed) ----------------------------
# Steam's storefront endpoints require no key and no account, so they are used
# automatically whenever IGDB isn't configured or is unreachable. There is
# nothing to set here — this note exists so the fallback isn't a surprise.


# --- Firebase (optional) ---------------------------------------------------
# Enables sign-in, watchlists and reviews. Create a project at
# https://console.firebase.google.com, add a Web App, and paste its config here.
#
# Then, in the Firebase console:
#   1. Authentication → Sign-in method → enable "Email/Password" and "Google"
#   2. Firestore Database → create a database
#   3. Firestore → Rules → paste the contents of `firestore.rules`
#   4. Authentication → Settings → Authorised domains → add your workers.dev domain
#
# These are NEXT_PUBLIC_* because the Firebase web SDK runs in the browser.
# That is expected and safe: Firebase web config is public by design, and access
# is controlled by the Firestore security rules, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional. Present in the Firebase config snippet but unused — Analytics is not
# wired up (it adds bundle weight and consent obligations). Safe to leave blank.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# --- Site URL (recommended for production) ---------------------------------
# Used for canonical URLs, sitemap.xml and social card images.
# Example: https://arnav-games.arnavrival12.workers.dev  (no trailing slash)
NEXT_PUBLIC_SITE_URL=


# --- Scheduled jobs --------------------------------------------------------
# Shared secret the Worker's cron triggers send as `x-cron-secret` to
# /api/cron/* (see worker.mjs). Any long random string:
#   npx wrangler secret put CRON_SECRET
# Not needed in `next dev`: loopback requests to the cron routes are allowed.
CRON_SECRET=
