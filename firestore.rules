rules_version = '2';

// Firestore security rules for Arnav Games (project ludex-7170f).
//
// Deploy: firebase deploy --only firestore:rules --project ludex-7170f
// (firebase.json points here). The console's Rules tab shows the live copy.
//
// Principles:
//  - A signed-in user may only ever read and write their own documents, and
//    every write is shape-checked: only known fields, with sane types and
//    sizes. Updates check only the fields they change, so a document written
//    before a rule existed never becomes un-editable.
//  - Reviews are world-readable (they're public commentary) but the author is
//    pinned to the authenticated uid, so nobody can post under another name.
//  - Our own sampled statistics (player/Twitch/review/score/price/release
//    history) are public and read-only: the browser reads them directly so a
//    chart costs no Cloudflare Worker request, and only the server — the
//    Admin service account over REST, which bypasses these rules — writes.
//  - Everything not matched below is denied by the final catch-all.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The fields a write sets: every field on create, only the changed ones
    // on update.
    function touched() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    function changes(field) {
      return touched().hasAny([field]);
    }

    function optionalString(field, max) {
      return !changes(field)
        || request.resource.data[field] == null
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    function optionalList(field, max) {
      return !changes(field)
        || (request.resource.data[field] is list && request.resource.data[field].size() <= max);
    }

    // --- My PC (inside preferences) ---------------------------------------
    // Mirrors `parsePcSpecs` in src/lib/preferences/pc.ts. The three parts
    // are required; everything after them is optional and vocabulary-checked.
    // `get(field, default)` lets an absent optional field pass its check.
    function validPcSpecs(p) {
      return p is map
        && p.keys().hasOnly(['cpu', 'gpu', 'ramGb', 'formFactor', 'vramGb', 'storage',
                             'freeStorageGb', 'os', 'display', 'goal'])
        && p.cpu is string && p.cpu.size() <= 120
        && p.gpu is string && p.gpu.size() <= 120
        && p.ramGb is number && p.ramGb > 0 && p.ramGb <= 1024
        && p.get('formFactor', 'desktop') in ['desktop', 'laptop', 'handheld']
        && p.get('vramGb', 1) is number && p.get('vramGb', 1) > 0 && p.get('vramGb', 1) <= 128
        && p.get('storage', 'nvme') in ['nvme', 'sata-ssd', 'hdd']
        && p.get('freeStorageGb', 1) is number && p.get('freeStorageGb', 1) > 0 && p.get('freeStorageGb', 1) <= 100000
        && p.get('os', 'windows') in ['windows', 'macos', 'linux', 'steamos']
        && validPcDisplay(p.get('display', {'resolution': '1080p'}))
        && validPcGoal(p.get('goal', {'resolution': '1080p', 'fps': 60, 'quality': 'high'}));
    }

    function validPcDisplay(d) {
      return d is map
        && d.keys().hasOnly(['resolution', 'refreshHz'])
        && d.resolution in ['720p', '1080p', '1440p', '4k']
        && d.get('refreshHz', 60) is number && d.get('refreshHz', 60) > 0 && d.get('refreshHz', 60) <= 1000;
    }

    function validPcGoal(g) {
      return g is map
        && g.keys().hasOnly(['resolution', 'fps', 'quality'])
        && g.resolution in ['720p', '1080p', '1440p', '4k']
        && g.fps in [30, 60, 120]
        && g.quality in ['low', 'medium', 'high', 'max'];
    }

    // --- Profiles ---------------------------------------------------------
    // Private to the account holder. Reviews carry their own public author
    // snapshot, so exposing the profile document would only leak account data.
    function validProfile() {
      return touched().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'bio', 'favouriteGenre',
          'ownedPlatforms', 'activeSubscriptions', 'gamerTag', 'playStyle',
          'createdAt', 'createdAtServer', 'updatedAt'
        ])
        && optionalString('displayName', 100)
        && optionalString('email', 320)
        && optionalString('photoURL', 2048)
        && optionalString('bio', 2000)
        && optionalString('favouriteGenre', 100)
        && optionalString('gamerTag', 64)
        && optionalList('ownedPlatforms', 60)
        && optionalList('activeSubscriptions', 30)
        && (!changes('playStyle') || request.resource.data.playStyle == null
            || request.resource.data.playStyle in ['casual', 'balanced', 'dedicated', 'competitive']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid && validProfile();
      allow update: if isOwner(uid) && request.resource.data.uid == resource.data.uid && validProfile();
      allow delete: if isOwner(uid);

      // --- Library / watchlist -------------------------------------------
      // Fully private. One document per game with a catalogue snapshot plus
      // personal state (status, ownership, subscriptions, follows); only the
      // personal fields with a fixed vocabulary are checked here.
      function validLibraryEntry(gameId) {
        return request.resource.data.keys().size() <= 64
          && (!changes('gameId') || request.resource.data.gameId == int(gameId))
          && (!changes('status') || request.resource.data.status in ['none', 'want', 'playing', 'played'])
          && (!changes('watchlisted') || request.resource.data.watchlisted is bool)
          && (!changes('following') || request.resource.data.following is bool)
          && optionalList('ownedOn', 40)
          && optionalList('subscriptionAccess', 40)
          && optionalList('followedReleases', 2000)
          && optionalString('platform', 64);
      }

      match /watchlist/{gameId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validLibraryEntry(gameId);
      }

      // --- Preferences ----------------------------------------------------
      // users/{uid}/settings/preferences: display and device preferences,
      // mirrored from the device (see PreferencesProvider.tsx). Private.
      function validPreferences() {
        let data = request.resource.data;
        return touched().hasOnly([
            'reduceMotion', 'posterSizes', 'notificationReadIds', 'notificationReleases',
            'theme', 'priceRegion', 'pcSpecs', 'recentSearches', 'wishlistBudget',
            'updatedAt', 'updatedAtServer'
          ])
          && (!changes('reduceMotion') || data.reduceMotion is bool)
          && (!changes('notificationReleases') || data.notificationReleases is bool)
          && (!changes('posterSizes') || (data.posterSizes is map && data.posterSizes.size() <= 50))
          && optionalList('notificationReadIds', 500)
          && (!changes('theme') || data.theme in ['system', 'light', 'dark'])
          && (!changes('priceRegion') || data.priceRegion == null
              || (data.priceRegion is string && data.priceRegion.matches('^[A-Z]{2}$')))
          && (!changes('pcSpecs') || data.pcSpecs == null || validPcSpecs(data.pcSpecs))
          && optionalList('recentSearches', 8)
          && (!changes('wishlistBudget') || data.wishlistBudget == null
              || (data.wishlistBudget is map
                  && data.wishlistBudget.keys().hasOnly(['currency', 'amount'])
                  && data.wishlistBudget.currency is string && data.wishlistBudget.currency.matches('^[A-Z]{3}$')
                  && data.wishlistBudget.amount is number && data.wishlistBudget.amount >= 0))
          && (!changes('updatedAt') || data.updatedAt is number)
          && (!changes('updatedAtServer') || data.updatedAtServer is timestamp);
      }

      match /settings/preferences {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPreferences();
      }

      // --- Recommendation feedback ----------------------------------------
      // users/{uid}/feedback/{gameId}: "more like this", "not interested" or
      // thumbs-down on a recommendation (see src/lib/recs/feedback.ts). Only
      // ever three fields; the document id must be the game's IGDB id so one
      // game can never carry two opinions.
      function validFeedback(gameId) {
        let data = request.resource.data;
        return data.keys().hasOnly(['gameId', 'kind', 'at'])
          && data.keys().hasAll(['gameId', 'kind', 'at'])
          && data.gameId is int && data.gameId > 0 && data.gameId == int(gameId)
          && data.kind in ['up', 'down', 'not-interested', 'ignored']
          && data.at is int && data.at > 0;
      }

      match /feedback/{gameId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validFeedback(gameId);
      }

      // --- Play journal -----------------------------------------------------
      // users/{uid}/journal/{entryId}: one session note (src/lib/personal/
      // store.ts). Private. A game snapshot (id, slug, name, cover) lets the
      // profile timeline render without fetching every game; the note is
      // capped, the mood is a fixed vocabulary, session hours are bounded.
      // Game ids may be negative (Steam-only titles), never zero.
      function validJournalEntry() {
        let data = request.resource.data;
        return data.keys().hasOnly(['gameId', 'slug', 'name', 'image', 'note', 'mood', 'hours', 'at'])
          && data.keys().hasAll(['gameId', 'slug', 'name', 'note', 'mood', 'at'])
          && data.gameId is int && data.gameId != 0
          && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200
          && data.name is string && data.name.size() > 0 && data.name.size() <= 200
          && (data.get('image', null) == null || (data.image is string && data.image.size() <= 2048))
          && data.note is string && data.note.size() <= 1000
          && data.mood in ['great', 'good', 'okay', 'meh', 'frustrated']
          && (data.get('hours', null) == null || (data.hours is number && data.hours > 0 && data.hours <= 48))
          && data.at is int && data.at > 0;
      }

      match /journal/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validJournalEntry();
      }

      // --- Personal playtime -----------------------------------------------
      // users/{uid}/playtime/{gameId}: the reader's own total hours for one
      // game. The document id must be the game id, so one game never has two
      // totals.
      function validPlaytime(gameId) {
        let data = request.resource.data;
        return data.keys().hasOnly(['gameId', 'hours', 'updatedAt'])
          && data.keys().hasAll(['gameId', 'hours', 'updatedAt'])
          && data.gameId is int && data.gameId == int(gameId)
          && data.hours is number && data.hours > 0 && data.hours <= 100000
          && data.updatedAt is int && data.updatedAt > 0;
      }

      match /playtime/{gameId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPlaytime(gameId);
      }

      // --- What you paid -----------------------------------------------------
      // users/{uid}/purchases/{gameId}: one purchase per game (the document
      // id is the game id), for the spending tracker (src/lib/personal/
      // spend.ts). `amount` is in minor units of `currency` (an ISO 4217
      // code), bounded so a typo of extra zeros is refused; `store` is an
      // ownership slug; `at` is the purchase date (UTC midnight), not in the
      // future beyond a two-day zone allowance.
      function validPurchase(gameId) {
        let data = request.resource.data;
        return data.keys().hasOnly(['gameId', 'amount', 'currency', 'store', 'at', 'updatedAt'])
          && data.keys().hasAll(['gameId', 'amount', 'currency', 'store', 'at', 'updatedAt'])
          && data.gameId is int && data.gameId != 0 && data.gameId == int(gameId)
          && data.amount is int && data.amount >= 0 && data.amount <= 10000000000
          && data.currency is string && data.currency.matches('^[A-Z]{3}$')
          && data.store is string && data.store.matches('^[a-z0-9-]{1,40}$')
          && data.at is int && data.at >= 0 && data.at <= request.time.toMillis() + 172800000
          && data.updatedAt is int && data.updatedAt > 0;
      }

      match /purchases/{gameId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPurchase(gameId);
      }

      // --- Your tags --------------------------------------------------------
      // users/{uid}/gameTags/{gameId}: the tags this reader gave one game.
      // Readable by its owner; written only by the server (POST /api/tags,
      // which verifies the ID token and keeps communityTags/{gameId} in step
      // in the same commit), so the public counts can't drift or be stuffed.
      match /gameTags/{gameId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // --- Reviews ----------------------------------------------------------
    // Document id is `{gameId}__{uid}`, which structurally enforces one review
    // per user per game. The rules additionally verify the embedded uid matches
    // the caller, so the id convention can't be worked around.
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && reviewId == string(request.resource.data.gameId) + '__' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Public statistics (server-written, read-only to everyone) --------
    // One document per series; see src/lib/games/stats-docs.ts. Single-doc
    // `get` only: no `list`, so nobody can page through whole collections
    // (each document read counts against the free daily quota).
    match /playerHistory/{appId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /twitchHistory/{twitchId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /reviewHistory/{appId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /scoreHistory/{gameId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /priceHistory/{key} {
      allow get: if true;
      allow list, write: if false;
    }
    match /releaseHistory/{shard} {
      allow get: if true;
      allow list, write: if false;
    }

    // Community tags: communityTags/{gameId} — { counts: { tag: n }, total,
    // updatedAt }. Public read, written only by the server (POST /api/tags,
    // which bypasses rules), never by clients.
    match /communityTags/{gameId} {
      allow get: if true;
      allow list, write: if false;
    }

    // The crons' work queue (trackedGames/index) is server-only: it holds
    // view recency, which isn't anyone's business. Covered by the default
    // deny below; listed here so its absence from the public set is explicit.
    match /trackedGames/{doc} {
      allow read, write: if false;
    }

    // --- Default deny -----------------------------------------------------
    // Anything not matched above is denied outright, for reads and writes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
