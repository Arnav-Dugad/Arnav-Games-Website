rules_version = '2';

// Firestore security rules for Arnav Games.
//
// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// Principles:
//  - A signed-in user may only ever write their own documents.
//  - Reviews are world-readable (they're public commentary) but the author is
//    pinned to the authenticated uid, so nobody can post under another name.
//  - Watchlists are private to their owner.
//  - Everything not matched below is denied by the final catch-all.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // --- Profiles ---------------------------------------------------------
    // Private to the account holder. Reviews carry their own public author
    // snapshot, so exposing the profile document would only leak account data.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.uid == uid;
      allow update: if isOwner(uid) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(uid);

      // --- Watchlist ------------------------------------------------------
      // Fully private: only the owner can read or write their tracked games.
      match /watchlist/{gameId} {
        allow read, write: if isOwner(uid);
      }

      // --- Settings -------------------------------------------------------
      // Display preferences (motion, layout, alerts). Private to the
      // owner: unlike the profile above, nothing here is shown to anyone else,
      // so there is no reason for it to be world-readable.
      match /settings/{document} {
        allow read, write: if isOwner(uid);
      }

    }

    // --- Reviews ----------------------------------------------------------
    // Document id is `{gameId}__{uid}`, which structurally enforces one review
    // per user per game. The rules additionally verify the embedded uid matches
    // the caller, so the id convention can't be worked around.
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && reviewId == string(request.resource.data.gameId) + '__' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 10
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 4000;

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Default deny -----------------------------------------------------
    // Anything not matched above is denied outright, for reads and writes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
