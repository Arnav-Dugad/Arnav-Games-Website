{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arnav-games",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by the ISR revalidation queue; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "arnav-games"
    }
  ],
  "r2_buckets": [
    {
      // Backs Next's data cache (IGDB responses, ISR pages).
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "arnav-games-opennext-cache"
    }
  ],
  "d1_databases": [
    {
      // Release-date history (delay tracker) and first-party analytics.
      "binding": "DB",
      "database_name": "arnav-games",
      "database_id": "4f2aa1df-022e-4c02-b900-1a8dad25d6e4",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      // Live "online now" counter for /admin (src/server/presence-room.ts).
      { "name": "PRESENCE", "class_name": "PresenceRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1-presence", "new_sqlite_classes": ["PresenceRoom"] }
  ],
  "triggers": {
    // One trigger (the Free plan allows 5 per account, shared with other
    // Workers); worker.mjs decides which jobs are due on each run.
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
