{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arnav-games",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by the ISR revalidation queue; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "arnav-games"
    }
  ],
  "r2_buckets": [
    {
      // Backs Next's data cache (IGDB responses, ISR pages).
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "arnav-games-opennext-cache"
    }
  ],
  // No D1: every table moved to Firestore (see src/lib/games/stats-docs.ts
  // and scripts/migrate-d1-to-firestore.ts). The `arnav-games` D1 database
  // still exists in the Cloudflare account as a read-only backup until it is
  // deleted with `npx wrangler d1 delete arnav-games`.
  // The PresenceRoom Durable Object (admin "online now") was removed; v2
  // deletes its class so Cloudflare drops the namespace.
  "migrations": [
    { "tag": "v1-presence", "new_sqlite_classes": ["PresenceRoom"] },
    { "tag": "v2-remove-presence", "deleted_classes": ["PresenceRoom"] }
  ],
  "triggers": {
    // One trigger (the Free plan allows 5 per account, shared with other
    // Workers); worker.mjs decides which jobs are due on each run.
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
